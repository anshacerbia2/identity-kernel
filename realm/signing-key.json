{
  "name": "realm-signing-ps256",
  "providerId": "java-keystore",
  "providerType": "org.keycloak.keys.KeyProvider",
  "config": {
    "priority": ["200"],
    "algorithm": ["PS256"],
    "active": ["true"],
    "enabled": ["true"],
    "keystore": ["realm-signing.p12"],
    "keystoreType": ["PKCS12"],
    "keyAlias": ["realm-signing"],
    "keystorePassword": ["${vault.realm-signing-password}"],
    "keyPassword": ["${vault.realm-signing-password}"]
  }
}
