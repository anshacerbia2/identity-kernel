            "flow": "scnehaux-browser-v2 level 1",
            "requirement": "CONDITIONAL",
            "executions": [
              {
                "authenticator": "conditional-level-of-authentication",
                "requirement": "REQUIRED",
                "configAlias": "scnehaux-browser-v2 loa 1",
                "config": {
                  "loa-condition-level": "1",
                  "loa-max-age": "36000"
                }
              },
              {
                "authenticator": "auth-username-password-form",
                "requirement": "REQUIRED"
              }
            ]
          },
          {
            "flow": "scnehaux-browser-v2 level 2",
            "requirement": "CONDITIONAL",
            "executions": [
              {
                "authenticator": "conditional-level-of-authentication",
                "requirement": "REQUIRED",
                "configAlias": "scnehaux-browser-v2 loa 2",
                "config": {
                  "loa-condition-level": "2",
                  "loa-max-age": "300"
