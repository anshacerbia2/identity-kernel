# Copy to .env beside compose.yaml and fill in. .env is git-ignored; never commit it.

# The public hostname. It fixes every token's issuer: https://<this>/realms/scnehaux
KEYCLOAK_HOSTNAME=identity.dev.example.com

# Addresses allowed to reach /admin and /realms/master, space-separated CIDRs.
# Your own public address, e.g. 203.0.113.7/32 -- find it with: curl -s https://ifconfig.me
ADMIN_ALLOW_CIDRS=203.0.113.7/32

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# realm-apply's service account, once create-apply-client.sh has made it. It authenticates with
# ./keys/<this>.pem, made by new-client-key.sh. There is no client secret. Leave it empty on a
# throwaway instance to apply as the bootstrap administrator.
KEYCLOAK_ADMIN_CLIENT_ID=

# The Go module proxy the Caddy image builds through (caddy.Dockerfile). Set GOPROXY=direct where the
# network intercepts TLS to proxy.golang.org; go.sum and the checksum database still verify every module.
# GOPROXY=https://proxy.golang.org,direct

# Tunnel mode only (README.md, Behind a dev tunnel instead of a DNS name). Leave both commented
# behind a DNS name.
#
# The Admin Console's URL, for tunnel-admin.sh and compose.tunnel.yaml. Default http://localhost:8081.
# KEYCLOAK_ADMIN_URL=http://localhost:8081
#
# The files compose reads, so every command is plain `docker compose` with no -f. A -f on the command
# line replaces this list. compose.local.yaml is this server's own file, copied from
# compose.override.example.yaml; leave it out of the list until it exists, because compose refuses a
# file that is missing.
# COMPOSE_FILE=compose.yaml:compose.tunnel.yaml:compose.local.yaml
