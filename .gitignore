# Local environment. Never committed: it holds this machine's credentials.
.env

# Client private keys made by deploy/dev/new-client-key.sh. They never leave the host that made them.
keys/
*.pem

# A server's own compose changes, copied from deploy/dev/compose.override.example.yaml. Never committed.
deploy/dev/compose.override.yaml
deploy/dev/compose.local.yaml

# Build and test output.
*.out
coverage

# Editor and OS noise.
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# The browser suite's dependencies and output.
node_modules/
test-results/
playwright-report/

# The image scan's database and archives, when scripts/image-scan.sh runs outside CI.
.image-scan/
